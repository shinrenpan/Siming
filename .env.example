# Siming FHIR R4 Server — environment variable template
# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit secrets.
#
# Environment variables override the corresponding config.yml fields.

# ── Database ──────────────────────────────────────────────────────────────────

# Postgres credentials (must match what your DB server expects)
PGUSER=siming
PGPASSWORD=siming
PGDATABASE=siming

# Alternative: single connection URL (takes priority over PG* vars)
# DATABASE_URL=postgres://siming:siming@db:5432/siming

# ── Server ────────────────────────────────────────────────────────────────────

# Public base URL — set this when running behind a reverse proxy. Every absolute URL
# Siming emits (Bundle links, fullUrl, Location, Content-Location) starts with it.
# A path prefix is allowed; the proxy must strip it before forwarding to Siming.
# SERVER_BASE_URL=https://fhir.example.com/fhir

# TCP port exposed on the host
# SERVER_PORT=8080

# ── External validator ────────────────────────────────────────────────────────

# Uncomment to enable deep TW Core profile validation via HL7 FHIR Validator.
# Also uncomment the `validator` service block in docker-compose.yml.
# VALIDATOR_URL=http://validator:4567

# ── SMART on FHIR (optional) ──────────────────────────────────────────────────

# Set SMART_ISSUER to enable JWT bearer authentication.
# SMART_ISSUER=https://auth.example.com
# SMART_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# SMART_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Compared to the token's aud claim by exact string equality: case-sensitive, no URL
# normalisation, and a trailing slash is a different string. Leave unset to skip the
# check entirely. See docs/smart-on-fhir.md.
# SMART_AUDIENCE=https://fhir.example.com

# The paired authorization server. Both or neither — setting one alone fails at startup.
# SMART_AUTHORIZE_URL=https://auth.example.com/authorize
# SMART_TOKEN_URL=https://auth.example.com/token

# Published to clients as jwks_uri. Set this when SMART_JWKS_URL is only reachable from
# inside the container network — clients read jwks_uri from outside it. Defaults to
# SMART_JWKS_URL.
# SMART_ADVERTISED_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# ── Rate limiting (optional) ──────────────────────────────────────────────────

# RATE_LIMIT_RPS=100
# RATE_LIMIT_BURST=200

# Clients are keyed by TCP peer address (IPv6 per /64). Behind a reverse proxy, list
# the proxy's address(es) here — IPs or CIDRs, comma-separated — and X-Forwarded-For
# is read right to left, skipping these hops. Without this, every request through the
# proxy shares the proxy's bucket. A malformed entry fails startup.
#
# List ONLY hosts that append (or overwrite) X-Forwarded-For. Never list a range that
# also holds something forwarding traffic untouched — notably the Docker bridge gateway
# (172.17.0.1, which a broad 172.16.0.0/12 covers): a request arriving through it keeps
# the client's own header, and the client picks its bucket.
# RATE_LIMIT_TRUSTED_PROXIES=10.0.5.20

# ── Logging ───────────────────────────────────────────────────────────────────

# LOG_LEVEL=info
